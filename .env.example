# Copy to .env.local and fill in before production launch.
# Nothing here is required for local development — the lead form
# falls back to a mock CRM handler when these are empty (see services/crm.ts).

# --- Kaiten CRM integration ---
# TODO: request from business owner / Kaiten workspace admin.
KAITEN_API_TOKEN=
KAITEN_API_URL=https://vivakitchen.kaiten.ru/api/latest
KAITEN_BOARD_ID=
KAITEN_COLUMN_ID=

# --- Email notifications (independent safety net, works alongside Kaiten) ---
# Sends a plain-text lead notification via SMTP. Recommended: a Yandex
# Mail "app password" for vivakitchenspb@yandex.ru, NOT the account
# password — generate one at https://id.yandex.ru/security/app-passwords
# (choose "Почта" as the app type). See README "Как подключить
# email-уведомления о заявках" for the full steps.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=vivakitchenspb@yandex.ru
SMTP_PASS=
LEAD_NOTIFY_EMAIL=vivakitchenspb@yandex.ru

# --- Analytics ---
# TODO: create a Yandex.Metrika counter for the site and paste its ID.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Maps ---
# Not needed for the basic embedded Yandex Map iframe already wired up
# (see config/site.ts → yandexMapsEmbedSrc). Only needed if we move to
# the JS Maps API for a custom-styled map later.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# --- Site URL (used for canonical/OG tags and sitemap) ---
NEXT_PUBLIC_SITE_URL=https://vivakitchen-spb.ru
